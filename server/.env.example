# ---------------------------------------------------------------------------
# deepseek-of-duty leaderboard service (server/leaderboard.mjs)
#
# This file is a reference only. The server does not load .env automatically
# (zero dependencies, no dotenv). Use one of:
#   set -a; . ./server/.env; set +a; node server/leaderboard.mjs
#   systemd EnvironmentFile=/etc/dod-leaderboard.env
#
# Copy to a private file, fill in a real secret, and never commit it.
# ---------------------------------------------------------------------------

# HTTP port. Put nginx in front; do not expose this port to the public internet.
PORT=8787

# HMAC key for /api/ticket. Generate one with:
#   openssl rand -hex 32
# If empty, the server generates an ephemeral secret and prints a warning;
# outstanding tickets stop working after a restart.
LB_SECRET=replace-with-a-long-random-secret

# Comma-separated allowlist of browser origins (scheme + host + port, no path).
# Production: only the public site origin.
# Development defaults also include the Vite dev server.
LB_ORIGINS=https://dod.goodpoint.top,http://127.0.0.1:5173,http://localhost:5173

# Directory for leaderboard.json. Relative paths resolve against the process
# working directory; in production prefer an absolute path owned by the service
# user, e.g. /var/lib/dod-leaderboard.
LB_DATA_DIR=./server/data

# Development only: accept submissions without a ticket. Never enable in
# production; it removes the one-time ticket gate entirely.
# LB_ALLOW_UNSIGNED=1
